# Paper crypto orders are simulated. Configured USTX NAV evidence may still publish to testnet.
TRADING_MODE=paper

# Required only for explicitly enabled live Upbit execution.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
LIVE_TRADING_CONFIRMATION=

# Protects operator endpoints. Identity headers are trusted only behind an authenticated edge.
IDENTITY_HEADER_TRUSTED=false
OPERATOR_TOKEN=
OPERATIONS_ALLOW_EMAILS=

# Settlement rail: xlayer-testnet (default, chain 1952) or giwa-sepolia.
SETTLEMENT_CHAIN=xlayer-testnet
# Defaults to the chain's public rate-limited RPC when omitted.
SETTLEMENT_RPC_URL=
SETTLEMENT_RELAYER_URL=
SETTLEMENT_RELAYER_TOKEN=
FUND_SHARE_ADDRESS=
NAV_REGISTRY_ADDRESS=

# GMD US TECH x — tokenized-stock basket priced on X Layer mainnet (chain 196).
# Constituent contracts; find and confirm them with `npm run xstocks:check`.
XSTOCKS_ADDRESSES=
# A NAV is published only when every price is younger than this (default 360).
XSTOCKS_MAX_QUOTE_AGE_MINUTES=
# OKX OnchainOS API credentials (web3.okx.com developer portal) for live prices.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
