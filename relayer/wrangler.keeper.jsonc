{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganymede-arbitrage-keeper",
  "main": "src/keeper.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Every five minutes, three minutes past each mark: the app's NAV record for the mark lands
  // within two, so a trade never races the next record. See src/keeper.ts.
  "triggers": { "crons": ["3-59/5 * * * *"] },

  "vars": {
    // GanymedeNavArbitrage, GanymedeDemoDollar and GanymedeRwaLiquidityHook on X Layer Testnet
    // (onchain/deployments/xlayer-testnet.json). With V4_HOOK_ADDRESS set, the keeper moves the
    // hook's Uniswap v4 pool to each NAV record; unset, it leaves the pool alone. With
    // RANGE_ARBITRAGE_ADDRESS (GanymedeRangeArbitrage) set, it brings the range pool to the NAV.
    "ARBITRAGE_ADDRESS": "0xaeba15aa92d6f3109e2b992f18933e1abe2fa3d9",
    "DOLLAR_ADDRESS": "0xf07535080f74e8b0f571e58dfa600f47e72ea9bf",
    "V4_HOOK_ADDRESS": "0x96a78af00ef351f294f2ccc05adf09b119f968c0",
    "RANGE_ARBITRAGE_ADDRESS": "0xbe0624ee3d949352498a767f1edbe235de38ca4d"
    // KEEPER_PRIVATE_KEY is a secret, never a var:
    //   npx wrangler secret put KEEPER_PRIVATE_KEY -c wrangler.keeper.jsonc
  }
}
