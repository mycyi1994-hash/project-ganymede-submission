{
  "name": "ganymede",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --experimental-loader ./tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "xstocks:check": "node --env-file-if-exists=.env --experimental-loader ./tests/cloudflare-loader.mjs scripts/xstocks-check.mjs",
    "verify:evidence": "node --disable-warning=ExperimentalWarning --experimental-loader ./tests/cloudflare-loader.mjs scripts/verify-evidence.mjs",
    "basket:publish": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-loader ./tests/cloudflare-loader.mjs scripts/basket-publish.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  }
}
