{
  "name": "ganymede-settlement-relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Signs and submits Ganymede settlement transactions to X Layer (or GIWA). With the arbitrage keeper (wrangler.keeper.jsonc), the only components that hold an EVM private key.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --experimental-loader ../tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ganymede-settlement-relayer",
    "db:migrate": "wrangler d1 execute ganymede-settlement-relayer --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute ganymede-settlement-relayer --local --file=./schema.sql"
  },
  "dependencies": {
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.115.0"
  }
}
